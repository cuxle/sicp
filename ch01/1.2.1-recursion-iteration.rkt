#lang sicp

;; ============================================================
;; SICP 1.2.1  线性递归与线性迭代
;; ============================================================
;;
;; 关键区分两个词：
;;   过程（procedure）= 代码长什么样（有没有调用自己）
;;   计算过程（process）= 运行时展开长什么样（空间/时间怎么长）
;; ============================================================

;; ---------- 版本 1：递归计算过程（线性递归）----------
;; 特点：先一路深入，再一路乘回来；「待做的乘法」会堆起来。

(define (factorial n)
  (if (= n 1)
      1
      (* n (factorial (- n 1)))))

;; (factorial 6)
;; 代换形状大致是：
;; (* 6 (* 5 (* 4 (* 3 (* 2 1)))))
;; 再从内往外算完。


;; ---------- 版本 2：迭代计算过程（线性迭代）----------
;; 特点：每一步只带着几个「状态变量」往前走；没有越堆越高的待办。

(define (factorial-iter n)
  (define (iter product counter)
    (if (> counter n)
        product
        (iter (* counter product)
              (+ counter 1))))
  (iter 1 1))

;; (factorial-iter 6)
;; 状态变化大致是：
;; (product, counter): (1,1)->(1,2)->(2,3)->(6,4)->(24,5)->(120,6)->(720,7) 停


;; ---------- 习题 1.9 相关的两个 + ----------
;; 第一个：递归计算过程（有延期的 inc）
(define (inc x) (+ x 1))
(define (dec x) (- x 1))

(define (+-rec a b)
  (if (= a 0)
      b
      (inc (+-rec (dec a) b))))

;; 第二个：迭代计算过程
(define (+-iter a b)
  (if (= a 0)
      b
      (+-iter (dec a) (inc b))))

