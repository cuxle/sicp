#lang sicp

;; ============================================================
;; SICP 1.1.7  例：求平方根（牛顿法）—— 带详细注释的完整版
;; ============================================================
;;
;; 目标：写一个 (sqrt x)，求出 x 的平方根。
;;
;; 学校公式「开方」在计算机里并不直接可用。
;; 我们换一种想法：猜一个答案，再不断改得更准。
;; ============================================================

;; ---------- 小工具 ----------

(define (square x)
  (* x x))

(define (average x y)
  (/ (+ x y) 2))

;; ---------- 改进猜测 ----------
;; 想法：如果 guess 是 x 的平方根候选，
;;       那 x/guess 也是另一个「相关」的数。
;;       真正的根往往夹在两者之间，所以取平均更接近。
;;
;;   improve(guess, x) = (guess + x/guess) / 2

(define (improve guess x)
  (average guess (/ x guess)))

;; ---------- 够不够好？ ----------
;; 如果 guess*guess 已经很接近 x，就停。
;; 这里用「差的绝对值 < 0.001」当标准（比较粗糙，后面习题会改进）。

(define (good-enough? guess x)
  (< (abs (- (square guess) x)) 0.001))

;; ---------- 主循环：猜 → 检查 → 改进 → 再猜 ----------

(define (sqrt-iter guess x)
  (if (good-enough? guess x)
      guess
      (sqrt-iter (improve guess x)
                 x)))

;; ---------- 对外接口：从 1.0 开始猜 ----------

(define (sqrt x)
  (sqrt-iter 1.0 x))

