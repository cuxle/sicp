#lang sicp

;; ============================================
;; SICP 1.1.5  过程应用的代换模型
;; ============================================
;;
;; 核心问题：调用一个过程时，计算是怎么发生的？
;; 答案（暂时）：把实参代换进形参，再求值函数体。
;; ============================================

(define (square x)
  (* x x))

(define (sum-of-squares x y)
  (+ (square x) (square y)))

(define (f a)
  (sum-of-squares (+ a 1) (* a 2)))

;; 试着在纸上 / 脑子里「代换」一遍：
;; (f 5)
;; 再在 REPL 里验证结果。

(f 5)

;; --------------------------------------------
;; 应用序 vs 正则序（先有个印象）
;; --------------------------------------------
;; 应用序（Scheme 实际用的）：先算参数，再代入
;; 正则序：完全展开后再归约
;;
;; 例子：
(define (id x) x)

;; 下面这行如果取消注释：应用序会立刻报错（除以 0）
;; 正则序则可能永远用不到那个坏参数
;; (+ 1 (/ 1 0))
